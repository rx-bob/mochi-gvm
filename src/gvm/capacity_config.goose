// Build-selected inline bounds shared by the VM's scratch and persistent pools.
namespace vm;

let SCRATCH_CAPACITY_BYTES = 131072;
let SCRATCH_CAPACITY_OBJECTS = 2048;
let SCRATCH_CAPACITY_IVARS = 2048;
let SCRATCH_CAPACITY_SLOTS = 4096;

let MAX_STATE_CLASSES = 512;
let MAX_STATE_OBJECTS = 32768;
let MAX_STATE_IVARS = 65536;
let MAX_STATE_SLOTS = 131072;
let MAX_STATE_BYTES = 8388608;
let MAX_STATE_COMPONENTS = 1024;
let MAX_PROMOTION_DEPTH = 32;
let MAX_BINDINGS = 2048;
let ABI_MAX_CALL_ARGS = 8;
let ABI_MAX_BYTECODE = 4194304;
